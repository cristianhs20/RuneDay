{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://runeday.local/schemas/sprite-manifest-v2.schema.json",
    "title": "RuneDay Sprite Manifest v2",
    "type": "object",
    "required": ["engine", "version", "asset_id", "type"],
    "properties": {
        "engine": {
            "const": "runeday-sprite-v2"
        },
        "version": {
            "type": "string",
            "pattern": "^2\\.\\d+\\.\\d+$"
        },
        "asset_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_\\-]+$"
        },
        "type": {
            "enum": [
                "character_base",
                "character_assembly",
                "equipment",
                "customization",
                "fx",
                "portrait"
            ]
        },
        "lineage": {
            "enum": ["human", "elf", "skeleton", "ogre"]
        },
        "fit_profile": {
            "enum": ["broad", "lean", "heavy"]
        },
        "slot": {
            "enum": ["weapon", "head", "chest", "feet", "back", "accessory"]
        },
        "item_slug": {
            "type": "string"
        },
        "cell": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
                "width": {
                    "const": 128
                },
                "height": {
                    "const": 128
                }
            },
            "additionalProperties": false
        },
        "views": {
            "type": "object"
        },
        "fits": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/fit"
            }
        }
    },
    "$defs": {
        "sheet": {
            "type": "object",
            "required": ["sheet", "frames"],
            "properties": {
                "sheet": {
                    "type": "string",
                    "minLength": 1
                },
                "frames": {
                    "type": "integer",
                    "minimum": 1
                },
                "fps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "loop": {
                    "type": "boolean"
                },
                "mirror_safe": {
                    "type": "boolean"
                },
                "sockets": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["frame"],
                        "properties": {
                            "frame": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "weapon_grip": {
                                "$ref": "#/$defs/point"
                            },
                            "offhand": {
                                "$ref": "#/$defs/point"
                            },
                            "head": {
                                "$ref": "#/$defs/point"
                            },
                            "back": {
                                "$ref": "#/$defs/point"
                            },
                            "fx_origin": {
                                "$ref": "#/$defs/point"
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "point": {
            "type": "array",
            "prefixItems": [
                {
                    "type": "integer"
                },
                {
                    "type": "integer"
                }
            ],
            "minItems": 2,
            "maxItems": 2
        },
        "animations": {
            "type": "object",
            "properties": {
                "idle": {
                    "$ref": "#/$defs/sheet"
                },
                "walk": {
                    "$ref": "#/$defs/sheet"
                },
                "attack": {
                    "$ref": "#/$defs/sheet"
                },
                "cast": {
                    "$ref": "#/$defs/sheet"
                },
                "celebrate": {
                    "$ref": "#/$defs/sheet"
                },
                "hurt": {
                    "$ref": "#/$defs/sheet"
                }
            },
            "additionalProperties": false
        },
        "views": {
            "type": "object",
            "properties": {
                "front": {
                    "$ref": "#/$defs/animations"
                },
                "side": {
                    "$ref": "#/$defs/animations"
                },
                "back": {
                    "$ref": "#/$defs/animations"
                }
            },
            "additionalProperties": false
        },
        "fit": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["alias"],
                    "properties": {
                        "alias": {
                            "enum": ["broad", "lean", "heavy"]
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "$ref": "#/$defs/views"
                }
            ]
        },
        "layer": {
            "type": "object",
            "required": ["id", "z", "sheet", "frames"],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "z": {
                    "type": "integer"
                },
                "sheet": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\.png$"
                },
                "frames": {
                    "type": "integer",
                    "minimum": 1
                },
                "fps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "loop": {
                    "type": "boolean"
                },
                "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "additionalProperties": false
        },
        "assemblyAnimations": {
            "type": "object",
            "properties": {
                "idle": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/layer"
                    },
                    "minItems": 1
                },
                "walk": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/layer"
                    },
                    "minItems": 1
                },
                "attack": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/layer"
                    },
                    "minItems": 1
                },
                "cast": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/layer"
                    },
                    "minItems": 1
                },
                "celebrate": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/layer"
                    },
                    "minItems": 1
                },
                "hurt": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/layer"
                    },
                    "minItems": 1
                }
            },
            "additionalProperties": false
        },
        "assemblyViews": {
            "type": "object",
            "properties": {
                "front": {
                    "$ref": "#/$defs/assemblyAnimations"
                },
                "side": {
                    "$ref": "#/$defs/assemblyAnimations"
                },
                "back": {
                    "$ref": "#/$defs/assemblyAnimations"
                }
            },
            "additionalProperties": false
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "type": {
                        "const": "equipment"
                    }
                }
            },
            "then": {
                "required": ["slot", "item_slug", "fits"]
            }
        },
        {
            "if": {
                "properties": {
                    "type": {
                        "const": "character_base"
                    }
                }
            },
            "then": {
                "required": ["lineage", "fit_profile", "cell", "views"],
                "properties": {
                    "views": {
                        "$ref": "#/$defs/views"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "type": {
                        "const": "character_assembly"
                    }
                }
            },
            "then": {
                "required": ["lineage", "fit_profile", "cell", "views"],
                "properties": {
                    "views": {
                        "$ref": "#/$defs/assemblyViews"
                    }
                }
            }
        }
    ],
    "additionalProperties": true
}
